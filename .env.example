# Gmail account that sends the welcome email (claire@beauxterre.com)
GMAIL_USER=claire@beauxterre.com
# 16-character App Password generated for GMAIL_USER (Google Account > Security > App Passwords)
GMAIL_APP_PASSWORD=

# monday.com personal API token (Avatar > Administration > API, or Profile > Developers)
MONDAY_API_TOKEN=

# Board that subscribers are added to. Defaults to the existing
# "Field Notes Subscribers" board (id 18431902072) if left unset.
MONDAY_BOARD_ID=18431902072
